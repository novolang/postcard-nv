// postcard — the compact `serde` wire format: varints, length-prefixed
// strings and sequences, and no schema on the wire at all.
//
// A struct becomes its members' encodings end to end, with nothing
// between them: no names, no lengths, no framing.  An unsigned integer
// is a LEB128 varint, a signed one is zigzag-folded first, a `u8` is one
// raw byte, an `f64` is eight little-endian bytes, a string is a varint
// byte count and then the bytes, a sequence is a varint count and then
// the elements, an enum is a varint variant index and then the payload,
// an optional is `0x00` or `0x01` and the value, and the unit is nothing
// (the postcard wire format specification, "Serde Data Model Types").
//
// Reading it back needs the type.  A member cannot be skipped without
// knowing its width, and nothing on the wire says when the writer and
// the reader disagree.
//
// There are two surfaces.
//
//   * The writer: `to_bytes` and `PostcardWriter`, the standard
//     library's `Serializer`.  It writes a novo-lang value with no code
//     to write.  Every `Int` goes out as a signed varint.
//   * The raw surface: `put_*` and `take_*` over a `Cursor`.  It writes
//     and reads the format part by part, and it is how a document is
//     read, because the standard library's `Deserializer` cannot advance
//     through a format with no names (see the README).
//
// The varint is leb128-nv's and the signed folding is zigzag-nv's.

use std.list
use std.bytes
use std.float
use leb128
use zigzag

// ── The wire faults ─────────────────────────────────────────────────

// What went wrong while reading postcard bytes.
//
// Every variant is an input fault, so it is a value: bytes arriving off
// a wire are data.  Each carries the offset of the value it was found
// in, because a payload with no framing gives a reader nothing else to
// go on.
//
// The names carry the `Postcard` prefix because a variant is
// constructed by name across the whole program, and `Truncated` is the
// name every codec wants.
pub enum PostcardError
    // The buffer ended in the middle of the value starting at `at`,
    // which needed `need` more bytes than were left.
    PostcardTruncated(at: Int, need: Int)
    // A varint longer than the ten bytes a 64-bit value takes, or whose
    // tenth byte holds bits above bit 63.  A reader that accepted one
    // would silently truncate.
    PostcardOverlongVarint(at: Int)
    // An `Option` discriminant or a `Bool` byte that is neither 0 nor 1.
    PostcardBadTag(at: Int, tag: Int)
    // A length-prefixed string whose bytes, starting at `at`, are not
    // UTF-8.
    PostcardBadUtf8(at: Int)
    // A value was read and `len` bytes were left over, starting at `at`.
    // `take_end` answers it for a caller that expected the buffer to hold
    // exactly one value.
    PostcardTrailingBytes(at: Int, len: Int)

// The standard `Error` implementation, so a bad payload can be reported
// by anything that reports errors.
impl Error for PostcardError
    // Answer the one-line report: what was wrong, and at what offset.
    fn message(self) -> Str
        match self
            PostcardTruncated(at, need)    =>
                "postcard: the buffer ends ${need} byte(s) short of the value at offset ${at}"
            PostcardOverlongVarint(at)     => "postcard: the varint at offset ${at} does not fit 64 bits"
            PostcardBadTag(at, tag)        => "postcard: byte ${tag} at offset ${at} is neither 0 nor 1"
            PostcardBadUtf8(at)            => "postcard: the string at offset ${at} is not UTF-8"
            PostcardTrailingBytes(at, len) =>
                "postcard: ${len} byte(s) left over at offset ${at}"

// ── The raw surface: the format, part by part ───────────────────────

// The most bytes a varint can occupy: 10, which is a 64-bit value at
// seven bits per byte.
//
// What a caller sizing a buffer for one integer reserves.
pub fn max_varint_len() -> Int
    leb128.max_len()

// How many bytes `v` occupies as an unsigned varint.
//
// A negative `v` is read as the unsigned 64-bit number with the same
// bits, which takes ten bytes.  A signed value belongs in `signed_len`,
// because postcard folds signed integers rather than sign-extending
// them.
//
// ```novo
// use postcard
//
// fn main() [io]
//     println("${postcard.unsigned_len(0)} ${postcard.unsigned_len(127)} ${postcard.unsigned_len(128)}")
//     // 1 1 2
// ```
pub fn unsigned_len(v: Int) -> Int
    leb128.encoded_len(v)

// How many bytes `v` occupies as a signed varint: zigzag, then LEB128.
//
// The folding keeps a small negative small: `-1` is one byte here and
// ten bytes without it.  It is what postcard does to every `iN`.
//
// ```novo
// use postcard
//
// fn main() [io]
//     println("${postcard.signed_len(-1)} ${postcard.signed_len(-64)} ${postcard.signed_len(-65)}")
//     // 1 1 2
// ```
pub fn signed_len(v: Int) -> Int
    leb128.encoded_len(zigzag.encode64(v))

// Write `v` as an unsigned varint at the cursor, and answer the bytes
// written.  postcard's `u16`, `u32`, `u64` and `usize`.
pub fn put_unsigned(var dst: Cursor, v: Int) -> Int
    leb128.encode_into(dst, v)

// Write `v` as a signed varint at the cursor, and answer the bytes
// written.  postcard's `i16`, `i32`, `i64` and `isize`, and what the
// writer writes for every `Int`.
pub fn put_signed(var dst: Cursor, v: Int) -> Int
    leb128.encode_into(dst, zigzag.encode64(v))

// Write the low eight bits of `v` as one raw byte, and answer 1.
// postcard's `u8` and `i8`, the two integers it does not varint.
pub fn put_byte(var dst: Cursor, v: Int) -> Int
    dst.put_u8(v & 255)
    1

// Write `v` as one byte, 0 or 1, and answer 1.
pub fn put_bool(var dst: Cursor, v: Bool) -> Int
    if v
        return put_byte(dst, 1)
    put_byte(dst, 0)

// Write `v` as eight little-endian bytes of IEEE 754 binary64, and
// answer 8.  postcard's `f64`, whatever byte order the cursor was made
// with.
pub fn put_f64(var dst: Cursor, v: Float) -> Int
    let raw = float.to_bits(v)
    for k in 0..8
        dst.put_u8((raw >>> (8 * k)) & 255)
    8

// Write `v` as a varint byte count and then its UTF-8 bytes, and answer
// the total.  postcard's `&str`, `String` and `char`.
pub fn put_str(var dst: Cursor, v: Str) -> Int
    put_bytes(dst, bytes.from_str(v))

// Write `v` as a varint byte count and then the bytes, and answer the
// total.  postcard's `&[u8]`.
pub fn put_bytes(var dst: Cursor, v: Bytes) -> Int
    let n = bytes.len(v)
    let head = put_unsigned(dst, n)
    dst.put_bytes(v)
    head + n

// Write the element count that opens a sequence or a map, and answer
// the bytes written.
//
// The encoding is `put_unsigned`'s.  The separate name lets a
// hand-written encoder read as the format.
pub fn put_seq_len(var dst: Cursor, n: Int) -> Int
    put_unsigned(dst, n)

// Write the variant index that opens an enum value, and answer the
// bytes written.  A varint, so the first 128 variants cost one byte.
pub fn put_variant(var dst: Cursor, index: Int) -> Int
    put_unsigned(dst, index)

// Write the `None` discriminant, one zero byte, and answer 1.
pub fn put_none(var dst: Cursor) -> Int
    put_byte(dst, 0)

// Write the `Some` discriminant, one `0x01` byte, and answer 1.  The
// value follows, written by the caller.
pub fn put_some(var dst: Cursor) -> Int
    put_byte(dst, 1)

// Read an unsigned varint at the cursor, which advances past it.
//
// A varint that is truncated leaves the cursor where the reading
// stopped; every other refusal leaves it after the bytes it read.
pub fn take_unsigned(var src: Cursor) -> Result<Int, PostcardError>
    let at = src.pos()
    match leb128.decode_from(src)
        Ok(v)                  => Ok(v)
        Err(Truncated(_after)) => Err(PostcardTruncated(at, 1))
        Err(Overflow(_after))  => Err(PostcardOverlongVarint(at))

// Read a signed varint at the cursor, which advances past it: LEB128,
// then unfolded from zigzag.
pub fn take_signed(var src: Cursor) -> Result<Int, PostcardError>
    Ok(zigzag.decode64(take_unsigned(src)!))

// Read one raw byte at the cursor, which advances past it.
pub fn take_byte(var src: Cursor) -> Result<Int, PostcardError>
    if src.remaining() < 1
        return Err(PostcardTruncated(src.pos(), 1))
    Ok(src.u8())

// Read one byte at the cursor as a boolean, which advances past it.
// Anything but 0 or 1 is `PostcardBadTag`.
pub fn take_bool(var src: Cursor) -> Result<Bool, PostcardError>
    let at = src.pos()
    let b = take_byte(src)!
    if b > 1
        return Err(PostcardBadTag(at, b))
    Ok(b == 1)

// Read eight little-endian bytes at the cursor as a double, which
// advances past them.
pub fn take_f64(var src: Cursor) -> Result<Float, PostcardError>
    let have = src.remaining()
    if have < 8
        return Err(PostcardTruncated(src.pos(), 8 - have))
    var raw = 0
    for k in 0..8
        raw = raw | (src.u8() << (8 * k))
    Ok(float.from_bits(raw))

// Read a varint-prefixed UTF-8 string at the cursor, which advances past
// it.
pub fn take_str(var src: Cursor) -> Result<Str, PostcardError>
    let raw = take_bytes(src)!
    let at = src.pos() - bytes.len(raw)
    if not is_utf8(raw)
        return Err(PostcardBadUtf8(at))
    Ok(bytes.to_str(raw))

// Read a varint-prefixed byte run at the cursor, which advances past it.
pub fn take_bytes(var src: Cursor) -> Result<Bytes, PostcardError>
    let at = src.pos()
    let n = take_unsigned(src)!
    let have = src.remaining()
    if n < 0 or n > have
        return Err(PostcardTruncated(at, n - have))
    Ok(src.bytes(n))

// Read the element count that opens a sequence or a map, and advance
// past it.
pub fn take_seq_len(var src: Cursor) -> Result<Int, PostcardError>
    take_unsigned(src)

// Read the variant index that opens an enum value, and advance past it.
pub fn take_variant(var src: Cursor) -> Result<Int, PostcardError>
    take_unsigned(src)

// Read an `Option` discriminant: `true` when a value follows, `false`
// when the option was `None`.  Anything but 0 or 1 is `PostcardBadTag`.
pub fn take_option(var src: Cursor) -> Result<Bool, PostcardError>
    take_bool(src)

// Check that the cursor is at the end of its buffer.
//
// `PostcardTrailingBytes` when it is not.  A caller decoding one message
// from one buffer calls this last; a caller reading a stream of messages
// does not, and starts the next one where the cursor stopped.
pub fn take_end(var src: Cursor) -> Result<Int, PostcardError>
    let left = src.remaining()
    if left > 0
        return Err(PostcardTrailingBytes(src.pos(), left))
    Ok(src.pos())

// ── The writer: a novo-lang value, with no code to write ────────────

// A postcard document being built.
//
// A `Serializer` is threaded rather than mutated: every method takes the
// writer and answers a new one.  So each writer holds the bytes its last
// call wrote and the writer before it, and `writer_bytes` joins the
// chain.  A write therefore costs the bytes it writes and never copies
// what came before.
pub struct PostcardWriter
    // The bytes the last call wrote.
    chunk: [Int]
    // The writer before that call, or `None` for a fresh one.
    before: ?PostcardWriter
    // How many bytes the whole chain holds.
    len: Int

// A fresh writer with nothing in it.
//
// ```novo
// use postcard
//
// fn main() [io]
//     let w = postcard.writer().put_int(3).put_bool(true)
//     println(bytes.to_hex(postcard.writer_bytes(w)))   // 0601
// ```
pub fn writer() -> PostcardWriter
    PostcardWriter { chunk: [], before: None, len: 0 }

// The bytes a writer accumulated, in the order they were written.
pub fn writer_bytes(w: PostcardWriter) -> Bytes
    var out = bytes.zeros(w.len)
    var end = w.len
    var cur: ?PostcardWriter = Some(w)
    loop
        match cur
            None       =>
                break
            Some(link) =>
                let n = link.chunk.len()
                end = end - n
                for i in 0..n
                    out = bytes.set_u8(out, end + i, link.chunk[i])
                cur = link.before
    out

// `w` with `chunk` written after everything it holds.
fn wrote(w: PostcardWriter, chunk: [Int]) -> PostcardWriter
    PostcardWriter { chunk: chunk, before: Some(w), len: w.len + chunk.len() }

// The bytes `v` occupies as a varint.
fn varint_bytes(v: Int) -> [Int]
    var c = bytes.cursor_le(bytes.zeros(leb128.max_len()))
    let n = leb128.encode_into(c, v)
    let raw = c.finish()
    var out: [Int] = []
    for i in 0..n
        list.push(out, bytes.byte_at(raw, i) ?? 0)
    out

// The format side, so a novo-lang struct or enum writes itself.
//
// A struct is its members end to end with nothing announcing them, so
// `begin_struct`, `field` and `end_struct` write nothing, and neither
// do `elem`, `end_seq`, `end_some` and `end_variant`.  The calls that
// write are the scalars, `begin_seq` (the element count),
// `begin_variant` (the variant index), `begin_some` (`0x01`) and
// `put_null` (`0x00`).
impl Serializer for PostcardWriter
    // An absent optional: the `0x00` discriminant.
    fn put_null(self) -> PostcardWriter
        wrote(self, [0])

    fn put_bool(self, v: Bool) -> PostcardWriter
        if v
            return wrote(self, [1])
        wrote(self, [0])

    // Every `Int` is a signed varint, which is postcard's `i64`.
    // novo-lang has one integer type and postcard has ten integer
    // encodings, so a wire that expects a `u32` needs the raw surface.
    fn put_int(self, v: Int) -> PostcardWriter
        wrote(self, varint_bytes(zigzag.encode64(v)))

    // Eight little-endian bytes, postcard's `f64`.
    fn put_float(self, v: Float) -> PostcardWriter
        let raw = float.to_bits(v)
        var out: [Int] = []
        for k in 0..8
            list.push(out, (raw >>> (8 * k)) & 255)
        wrote(self, out)

    // A varint byte count and then the UTF-8 bytes.
    fn put_str(self, v: Str) -> PostcardWriter
        let raw = bytes.from_str(v)
        var out = varint_bytes(bytes.len(raw))
        for i in 0..bytes.len(raw)
            list.push(out, bytes.byte_at(raw, i) ?? 0)
        wrote(self, out)

    // Nothing: a struct has no framing on this wire.
    fn begin_struct(self, name: Str, n: Int) -> PostcardWriter
        self

    // Nothing: members are told apart by order, and the walk visits
    // them in declaration order (SPEC § 3.8.1).
    fn field(self, name: Str) -> PostcardWriter
        self

    fn end_struct(self) -> PostcardWriter
        self

    // The element count, as a varint.
    fn begin_seq(self, n: Int) -> PostcardWriter
        wrote(self, varint_bytes(n))

    fn elem(self) -> PostcardWriter
        self

    fn end_seq(self) -> PostcardWriter
        self

    // A present optional: the `0x01` discriminant, then the value.
    fn begin_some(self) -> PostcardWriter
        wrote(self, [1])

    fn end_some(self) -> PostcardWriter
        self

    // The variant index, as a varint.  Under the default external
    // tagging, the struct and field calls the walk makes between here
    // and `end_variant` write nothing, so an enum value is its index and
    // its payload, which is what Rust postcard writes.
    fn begin_variant(self, enum_name: Str, variant: Str, index: Int, n: Int) -> PostcardWriter
        wrote(self, varint_bytes(index))

    fn end_variant(self) -> PostcardWriter
        self

// Write any serializable value as postcard bytes.
//
// ```novo
// use postcard
//
// struct Reading
//     sensor: Int
//     celsius: Float
//
// fn main() [io]
//     let b = postcard.to_bytes(Reading { sensor: 3, celsius: 21.5 })
//     println("${bytes.len(b)}")   // 9: one varint, eight bytes of double
// ```
pub fn to_bytes<T: Serialize>(v: T) -> Bytes
    writer_bytes(v.serialize(writer()))

// ── UTF-8 ───────────────────────────────────────────────────────────

// Whether `b` is well-formed UTF-8 (RFC 3629 section 4): no stray
// continuation byte, no overlong form, no surrogate, nothing past
// U+10FFFF.
fn is_utf8(b: Bytes) -> Bool
    let n = bytes.len(b)
    // Bytes of the current character still to come, and the range the
    // next one must fall in.
    var need = 0
    var lo = 0x80
    var hi = 0xBF
    for i in 0..n
        let c = bytes.byte_at(b, i) ?? 0
        if need > 0
            if c < lo or c > hi
                return false
            need = need - 1
            lo = 0x80
            hi = 0xBF
        else if c < 0x80
            need = 0
        else if c >= 0xC2 and c <= 0xDF
            need = 1
        else if c >= 0xE0 and c <= 0xEF
            need = 2
            if c == 0xE0
                lo = 0xA0
            if c == 0xED
                hi = 0x9F
        else if c >= 0xF0 and c <= 0xF4
            need = 3
            if c == 0xF0
                lo = 0x90
            if c == 0xF4
                hi = 0x8F
        else
            return false
    need == 0
